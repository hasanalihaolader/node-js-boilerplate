{
    "$schema": "https://biomejs.dev/schemas/1.5.2/schema.json",
    "linter": {
        "rules": {
            "suspicious": {
                "noExplicitAny": "off"
            },
            "performance": {
                "noDelete": "off"
            },
            "complexity": {
                "noForEach": "off"
            }
        }
    }
}