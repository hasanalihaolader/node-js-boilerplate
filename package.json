{
	"name": "node-js-boilerplate",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "tsup",
		"start:dev": "tsx watch --clear-screen=false src/index.ts",
		"start:prod": "node dist/index.js",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write",
		"test": "jest --watch",
		"test:cov": "jest --coverage --coverageReporters=text",
		"check": "npm lint && npm format && npm build && npm test"
	},
	"dependencies": {
		"bcrypt": "^5.1.1",
		"body-parser": "^1.20.2",
		"cookie-parser": "~1.4.4",
		"debug": "~2.6.9",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"http-errors": "~1.6.3",
		"jsonwebtoken": "^9.0.2",
		"morgan": "~1.9.1",
		"mysql2": "^3.0.0",
		"pug": "^3.0.3",
		"sequelize": "^6.37.2",
		"winston": "^3.13.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.24.7",
		"@babel/core": "^7.24.7",
		"@babel/preset-env": "^7.24.7",
		"@biomejs/biome": "1.9.4",
		"@jest/globals": "^29.7.0",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.1",
		"@types/http-errors": "^2.0.4",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.14.1",
		"copyfiles": "^2.4.1",
		"jest": "^29.7.0",
		"nodemon": "^3.1.0",
		"npm-run-all": "^4.1.5",
		"ts-jest": "^29.3.2",
		"ts-node-dev": "^2.0.0",
		"tsup": "^8.4.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3"
	},
	"tsup": {
		"entry": [
			"src/index.ts",
			"src/app.ts"
		],
		"splitting": false,
		"sourcemap": true,
		"clean": true,
		"loader": {
			".pug": "text",
			".log": "text",
			".sequelizerc": "text"
		},
		"exclude": [
			"src/storage/logs/**/*",
			"src/.sequelizerc"
		],
		"onSuccess": "copyfiles -u 1 src/views/**/* dist/"
	}
}
